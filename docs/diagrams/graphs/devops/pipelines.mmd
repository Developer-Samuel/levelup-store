graph TD
    %% Class Styles
    classDef pipelines fill:#000, color:#fff;
    classDef main fill:#1a7f5a, color:#fff, stroke:#000, stroke-width:2px;
    classDef pr fill:#6b21a8, color:#fff, stroke:#000, stroke-width:2px;
    classDef release fill:#b45309, color:#fff, stroke:#000, stroke-width:2px;

    %% Root
    Pipelines[🚀 GitHub Actions CI/CD]:::pipelines

    %% Pipelines
    Main[⚙️ main.yml]:::main
    PR[🔍 pull-request.yml]:::pr
    Release[📦 release.yml]:::release

    %% Connections
    Pipelines --> Main
    Pipelines --> PR
    Pipelines --> Release

##########################################################################
#                                                                        #
#                         🛠️ ACTIVE SETTINGS 🛠️                         #
#                                                                        #
##########################################################################

# ╭────────────────────────╮
#  ⚙️ Application Settings
# ╰────────────────────────╯
APP_ENV=test
APP_DEBUG=0
APP_URL=http://127.0.0.1:8000

# ╭───────────────────╮
#  🛡️ Security & CORS
# ╰───────────────────╯

# 🌐 Trusted proxy IPs - ensures correct client IP resolution behind reverse proxies / load balancers
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR

# 🔒 Allowed CORS origins - regex pattern matched against the request Origin header
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# ╭───────────────────╮
#  🗄️ Database Config
# ╰───────────────────╯
# Doctrine appends '_test' suffix automatically (doctrine.yaml → dbname_suffix).
# Real DB used by tests: levelup_store_test

### 👉 PostgreSQL (default)
SERVER_VERSION=17

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=levelup_store
DB_USERNAME=postgres
DB_PASSWORD=secret
DATABASE_URL=$DB_CONNECTION://$DB_USERNAME:$DB_PASSWORD@$DB_HOST:$DB_PORT/$DB_DATABASE

### 👉 MySQL (uncomment to use instead)
#SERVER_VERSION=8.0.42-MySQL

#DB_HOST=127.0.0.1
#DB_PORT=3306
#DB_DATABASE=levelup_store
#DB_USERNAME=root
#DB_PASSWORD=
#DATABASE_URL=mysql://$DB_USERNAME:$DB_PASSWORD@$DB_HOST:$DB_PORT/$DB_DATABASE?serverVersion=$SERVER_VERSION

# ╭───────────────────────╮
#  🧰 Redis Configuration
# ╰───────────────────────╯
REDIS_ENABLED=false

# ╭───────────────────────╮
#  📋 Audit Configuration
# ╰───────────────────────╯
AUDIT_LOGS_ENABLED=false

# ╭────────────────────────────╮
#  📊 Monitoring Configuration
# ╰────────────────────────────╯
SENTRY_DSN=

# ╭───────────────────────────────╮
#  🚀 Messenger / Queue Transport
# ╰───────────────────────────────╯
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# ╭─────────────────╮
#  📩 Mail Settings
# ╰─────────────────╯
MAILER_DSN=null://null

# ╭──────────────────╮
#  💳 Stripe Payment
# ╰──────────────────╯
STRIPE_SECRET=test

# ╭──────────────────────╮
#  🔑 JWT Authentication
# ╰──────────────────────╯
JWT_TTL=900
JWT_REFRESH_TTL=2592000

# ╭─────────────────────────╮
#  👤 Test User Credentials
# ╰─────────────────────────╯
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=Test123@

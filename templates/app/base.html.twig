<!DOCTYPE html>
<html>
    <head>
        {% import 'layout/public/head/head.html.twig' as Head %}
        {{ Head.render() }}
    </head>
    <body data-authenticated="{{ app.user ? 'true' : 'false' }}">
        {% import 'components/loading/loading.html.twig' as Loading %}
        {{ Loading.render() }}

        <div class="cursor" role="presentation" aria-hidden="true"></div>

        {% if not adminPaths %}
            {% import 'app/init/cookies.html.twig' as Cookies %}
            {% import 'app/init/reviews.html.twig' as Reviews %}
            {% import 'app/init/show-header.html.twig' as ShowHeader %}
            {% import 'app/init/show-footer.html.twig' as ShowFooter %}

            {{ Cookies.render(app.request) }}
            {{ Reviews.render(app.request, variant|default(null)) }}
            {{ ShowHeader.render(showHeader) }}

            <div id="scroll-to-top" role="button" aria-label="Scroll to top">
                <img src="{{ asset('img/icons/elements/arrow.png') }}" alt="Scroll to top">
            </div>

            {% block body %}{% endblock %}

            {{ ShowFooter.render(showFooter) }}
        {% elseif adminPaths %}
            {% import 'app/init/admin-structure.html.twig' as AdminLayout %}

            {{ AdminLayout.render(isAdminPath) }}

            {% block admin_body %}{% endblock %}
        {% endif %}
    </body>
</html>

{% macro render(
    categories,
    category,
    types,
    type,
    subtypes,
    brands,
    maxPrice,
    filterPriceStep,
    maxPriceActive,
    sortOptions,
    sort,
    productsTitle,
    currentPage,
    maxPages,
    variants,
    showLoadMore
) %}
    {% import 'features/product/catalog/filter/filter.html.twig' as Filter %}
    {% import 'features/product/catalog/content/card/card.html.twig' as Card %}

    <div class="products {% if variants|length == 0 %}no-filter{% endif %}">
        {% if variants|length > 0 %}
            {{
                Filter.render(
                    categories,
                    category,
                    types,
                    type,
                    subtypes,
                    brands,
                    maxPrice,
                    filterPriceStep,
                    maxPriceActive,
                    variants
                )
            }}
        {% endif %}

        {{
            Card.render(
                category,
                type,
                sortOptions,
                sort,
                productsTitle,
                currentPage,
                maxPages,
                variants,
                showLoadMore
            )
        }}
    </div>
{% endmacro %}
